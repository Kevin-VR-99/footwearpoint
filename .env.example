APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=footwearpoint
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

FILESYSTEM_DISK=productos
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

APP_TIMEZONE=America/Mexico_City
# Push (TG-135): ruta a la llave de la cuenta de servicio de Firebase.
# La llave NO va en el repo; se pasa por privado. Sin ella no se manda push.
FIREBASE_CREDENTIALS=storage/app/firebase/credenciales.json

# Contrasena de las cuentas de prueba que crea el seeder (TG-186).
# Si se deja vacia, en local y en pruebas se usa "password"; en produccion el
# seeder se detiene en vez de crear cuentas con una contrasena conocida.
SEED_PASSWORD=

# Fotos del catalogo de demostracion (TG-217). En true, el seeder sube las
# fotos de ejemplo al almacenamiento de productos; en pruebas nunca se suben.
SEED_IMAGENES=false

# Mercado Pago (TG-225): aplicación de FootwearPoint en Mercado Pago Developers.
# Los valores NO van en el repo: se configuran en Railway o en tu .env local.
# MP_REDIRECT_URI debe ser idéntica a la registrada en la aplicación,
# por ejemplo https://<dominio>/mercado-pago/callback
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=
# sandbox (pruebas) o produccion
MP_MODO=sandbox
# true si la aplicación tiene activado "código de autorización con PKCE"
MP_PKCE=true
# TG-228 (G9): clave secreta de Webhooks > Configurar notificaciones en la
# aplicación de Mercado Pago (se usa para revisar la firma de los avisos).
MP_WEBHOOK_SECRET=
# TG-230 (G11): access token de la cuenta de Mercado Pago de FootwearPoint
# (Credenciales de la aplicación). Cobra la mensualidad de las distribuidoras.
MP_ACCESS_TOKEN=

# TG-187 (A5): expiracion de la sesion de la app movil (token Sanctum).
# SANCTUM_INACTIVIDAD_MINUTOS: minutos sin usar la app antes de que la sesion
#   se venza. Cada peticion reinicia el reloj. 0 = no se revisa.
#   Por omision 20160 (14 dias).
# SANCTUM_EXPIRACION_MINUTOS: tope de vida del token desde que se creo,
#   aunque se use a diario. 0 = no caduca. Por omision 129600 (90 dias).
# Para la demostracion se pueden bajar a 1 o 2 minutos.
SANCTUM_INACTIVIDAD_MINUTOS=20160
SANCTUM_EXPIRACION_MINUTOS=129600
